<?xml version="1.0" encoding="UTF-8"?>
<!--
  ISO 20022 example — pain.008.001.08 (CustomerDirectDebitInitiation).
  Demonstrates ISO 20022's composition model: messages are assembled from reusable
  business components. The same creditor component block (Cdtr / CdtrAcct / CdtrAgt /
  CdtrSchmeId) recurs in both payment-information blocks, and the shared
  PaymentTypeInformation component (SvcLvl / LclInstrm / SeqTp) is reused with a
  different sequence type per block.
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:pain.008.001.08">
  <CstmrDrctDbtInitn>
    <GrpHdr>
      <MsgId>DD-20260116-0001</MsgId>
      <CreDtTm>2026-01-16T10:00:00</CreDtTm>
      <NbOfTxs>2</NbOfTxs>
      <CtrlSum>149.98</CtrlSum>
      <InitgPty>
        <Nm>Example Utilities AG</Nm>
      </InitgPty>
    </GrpHdr>
    <PmtInf>
      <PmtInfId>PMT-DD-0001</PmtInfId>
      <PmtMtd>DD</PmtMtd>
      <PmtTpInf>
        <SvcLvl><Cd>SEPA</Cd></SvcLvl>
        <LclInstrm><Cd>CORE</Cd></LclInstrm>
        <SeqTp>RCUR</SeqTp>
      </PmtTpInf>
      <ReqdColltnDt>2026-01-20</ReqdColltnDt>
      <Cdtr>
        <Nm>Example Utilities AG</Nm>
      </Cdtr>
      <CdtrAcct>
        <Id><IBAN>DE89370400440532013000</IBAN></Id>
      </CdtrAcct>
      <CdtrAgt>
        <FinInstnId><BICFI>COBADEFFXXX</BICFI></FinInstnId>
      </CdtrAgt>
      <CdtrSchmeId>
        <Id>
          <PrvtId>
            <Othr>
              <Id>DE98ZZZ09999999999</Id>
              <SchmeNm><Prtry>SEPA</Prtry></SchmeNm>
            </Othr>
          </PrvtId>
        </Id>
      </CdtrSchmeId>
      <DrctDbtTxInf>
        <PmtId><EndToEndId>E2E-DD-0001</EndToEndId></PmtId>
        <InstdAmt Ccy="EUR">99.99</InstdAmt>
        <DrctDbtTx>
          <MndtRltdInf>
            <MndtId>MANDATE-001</MndtId>
            <DtOfSgntr>2025-03-01</DtOfSgntr>
          </MndtRltdInf>
        </DrctDbtTx>
        <DbtrAgt>
          <FinInstnId><BICFI>DEUTDEFFXXX</BICFI></FinInstnId>
        </DbtrAgt>
        <Dbtr><Nm>Jane Doe</Nm></Dbtr>
        <DbtrAcct>
          <Id><IBAN>DE91100000000123456789</IBAN></Id>
        </DbtrAcct>
        <RmtInf><Ustrd>Electricity January 2026</Ustrd></RmtInf>
      </DrctDbtTxInf>
    </PmtInf>
    <PmtInf>
      <PmtInfId>PMT-DD-0002</PmtInfId>
      <PmtMtd>DD</PmtMtd>
      <PmtTpInf>
        <SvcLvl><Cd>SEPA</Cd></SvcLvl>
        <LclInstrm><Cd>CORE</Cd></LclInstrm>
        <SeqTp>FRST</SeqTp>
      </PmtTpInf>
      <ReqdColltnDt>2026-01-22</ReqdColltnDt>
      <Cdtr>
        <Nm>Example Utilities AG</Nm>
      </Cdtr>
      <CdtrAcct>
        <Id><IBAN>DE89370400440532013000</IBAN></Id>
      </CdtrAcct>
      <CdtrAgt>
        <FinInstnId><BICFI>COBADEFFXXX</BICFI></FinInstnId>
      </CdtrAgt>
      <CdtrSchmeId>
        <Id>
          <PrvtId>
            <Othr>
              <Id>DE98ZZZ09999999999</Id>
              <SchmeNm><Prtry>SEPA</Prtry></SchmeNm>
            </Othr>
          </PrvtId>
        </Id>
      </CdtrSchmeId>
      <DrctDbtTxInf>
        <PmtId><EndToEndId>E2E-DD-0002</EndToEndId></PmtId>
        <InstdAmt Ccy="EUR">49.99</InstdAmt>
        <DrctDbtTx>
          <MndtRltdInf>
            <MndtId>MANDATE-002</MndtId>
            <DtOfSgntr>2026-01-10</DtOfSgntr>
          </MndtRltdInf>
        </DrctDbtTx>
        <DbtrAgt>
          <FinInstnId><BICFI>NOLADE21KIE</BICFI></FinInstnId>
        </DbtrAgt>
        <Dbtr><Nm>John Roe</Nm></Dbtr>
        <DbtrAcct>
          <Id><IBAN>DE12500105170648489890</IBAN></Id>
        </DbtrAcct>
        <RmtInf><Ustrd>Gas January 2026</Ustrd></RmtInf>
      </DrctDbtTxInf>
    </PmtInf>
  </CstmrDrctDbtInitn>
</Document>
